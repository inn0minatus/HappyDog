# ─────────────────────────────────────────────────────────────────────────────
# Happy Dog Runner — environment variables (CLIENT-SUPPLIED CONFIG)
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` (or `.env.local`) and fill in per environment. Only variables
# prefixed with VITE_ are exposed to the client bundle (Vite convention).
#
# EVERY var below is OPTIONAL: `npm run build` and the app run correctly with
# ALL of them unset (see defaults in src/config/env.ts). When the analytics IDs
# are unset OR left at the placeholders below, analytics is a SAFE NO-OP — no
# vendor script loads, no network request, no console error.
# ─────────────────────────────────────────────────────────────────────────────

# GA4 Measurement ID. CLIENT MUST SUPPLY the real "G-XXXXXXXXXX" from their GA4
# property. The placeholder below is treated as "not configured" (GA4 disabled).
VITE_GA4_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel ID (15-digit numeric). CLIENT MUST SUPPLY the real id
# from Events Manager. The all-zero placeholder is treated as "not configured".
VITE_FB_PIXEL_ID=000000000000000

# Promo code shown/copied on the results CTA AND appended to the buy URL as
# `promo=`. CLIENT MUST CONFIRM the real code (spec §11); DOG10 is a placeholder.
VITE_PROMO_CODE=DOG10

# Base buy URL the CTA opens. CLIENT SHOULD SUPPLY the exact tabletki.ua product
# page. `promo=` + utm_* params are appended at runtime by buildBuyUrl().
VITE_BUY_URL=https://tabletki.ua

# Campaign attribution (UTM) appended to the buy URL. Adjust per campaign; the
# defaults are sensible for this game.
VITE_UTM_SOURCE=happydogrunner
VITE_UTM_MEDIUM=game
VITE_UTM_CAMPAIGN=tick_protection

# Mirror every track() call to console.debug for QA. "true" to enable, else off.
VITE_DEBUG_ANALYTICS=false
